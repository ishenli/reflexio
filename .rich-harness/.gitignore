# Auto-generated by rich-harness repospace init.
# 规则相对 .rich-harness/ 目录；按需扩展请改 src/commands/repospace/gitignore-template.js。

# gate / 部署机读 JSON，可由后续 loop 重生，体积可观
tasks/*/evidence/

# playwright 配置文件
tasks/*/.playwright-cli/
.playwright-cli/

# 研发态冒烟产物（smoke 脚本与 report，每次 loop 重写）
tasks/*/local-acceptance/
# 二进制 / 缓存产物（PRD 图片附件、截图、trace、冒烟脚本等）
tasks/*/artifacts/

# 本地验收截图已上传画眉，Git 只保留 spec/summary.md 中的 CDN 引用
tasks/*/screenshots/

# 过程记录（仅 loop 内部消费，最终结论汇总在 summary.md）
tasks/*/logs/events.ndjson
tasks/*/logs/observability.log
tasks/*/logs/impl-summary.md
tasks/*/logs/verification.md
tasks/*/logs/code-review.md
